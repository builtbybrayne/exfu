---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/setup-pages.css';

// Public marketplace
const MARKETPLACE_REPO = 'ExFu/exfu-marketplace';
const MARKETPLACE_URL = 'https://github.com/ExFu/exfu-marketplace';

const MARKETPLACE_ADD_CMD = `/plugin marketplace add ${MARKETPLACE_REPO}`;
const INSTALL_CMD = '/plugin install exfu-agent-library-solo@exfu';

const PLUGIN_DOCS_URL = 'https://docs.claude.com/en/docs/claude-code/plugins';
---

<BaseLayout
  title="Install — ExFu"
  description="Install the ExFu Agent Library plugin for Claude from the public exfu marketplace."
>
  <Nav />
  <main id="main">

    <!-- Hero -->
    <section class="ip-hero">
      <div class="ip-hero-inner section-container">
        <h1 class="ip-title">Install ExFu</h1>
        <p class="ip-lede">One plugin from a public marketplace. Your AI does the rest.</p>
      </div>
    </section>

    <!-- Step one: add the marketplace -->
    <section class="ip-marketplace">
      <div class="ip-marketplace-inner section-container">
        <h2 class="ip-section-title reveal">First, add the marketplace</h2>
        <p class="ip-marketplace-lede reveal">One command, once. Works in Claude Code and in Cowork on Claude Desktop.</p>

        <div class="gs-copy-block reveal">
          <pre id="cmd-marketplace" class="gs-prompt">{MARKETPLACE_ADD_CMD}</pre>
          <button
            class="gs-copy-btn"
            type="button"
            data-copy-target="cmd-marketplace"
            aria-label="Copy command to clipboard"
          >
            <span class="gs-copy-btn-label">Copy</span>
          </button>
        </div>

        <p class="ip-marketplace-note reveal">
          That points Claude at the public <a href={MARKETPLACE_URL} target="_blank" rel="noopener noreferrer">{MARKETPLACE_REPO}</a> marketplace.
        </p>
      </div>
    </section>

    <!-- The plugin -->
    <section class="ip-plugins">
      <div class="ip-plugins-inner section-container">
        <h2 class="ip-section-title reveal">Then, install the Agent Library</h2>

        <article class="ip-plugin-card reveal">
          <div class="ip-plugin-header">
            <h3 class="ip-plugin-name">Agent Library</h3>
          </div>
          <p class="ip-plugin-desc">Your knowledge base, your preferences, and the Agent Librarians that keep it all organised. Claude as a real working collaborator.</p>
          <div class="gs-copy-block">
            <pre id="cmd-install" class="gs-prompt">{INSTALL_CMD}</pre>
            <button
              class="gs-copy-btn"
              type="button"
              data-copy-target="cmd-install"
              aria-label="Copy install command to clipboard"
            >
              <span class="gs-copy-btn-label">Copy</span>
            </button>
          </div>
        </article>

        <p class="ip-marketplace-note reveal">
          New to Claude plugins? <a href={PLUGIN_DOCS_URL} target="_blank" rel="noopener noreferrer">How plugins work</a>.
        </p>
      </div>
    </section>

    <!-- Quick start -->
    <section class="ip-quickstart">
      <div class="ip-quickstart-inner section-container">
        <h2 class="ip-section-title reveal">Then what?</h2>

        <ol class="ip-steps reveal">
          <li>
            <span class="ip-step-num" aria-hidden="true">1</span>
            <span>Restart Claude so the plugin loads.</span>
          </li>
          <li>
            <span class="ip-step-num" aria-hidden="true">2</span>
            <span>Say <strong>"get me set up"</strong>. Your AI takes it from there.</span>
          </li>
        </ol>

        <p class="ip-stuck reveal">Not set up on your machine yet? Work through the <a href="/prepare">preparation steps</a> first. Questions? Email <a href="mailto:al@exfu.ai">al@exfu.ai</a>.</p>

      </div>
    </section>

    <!-- Pre-read for the curious -->
    <section class="ip-primer">
      <div class="ip-primer-inner section-container">
        <h2 class="ip-section-title reveal">Want to read first?</h2>
        <p class="reveal">
          Primers and guides ship inside the plugin. Once it's installed, ask for the ExFu guides and Claude will walk you through what the library is, how the librarians work, and how to extend it yourself.
        </p>
      </div>
    </section>

    <!-- Ecosystem references -->
    <section class="ip-ecosystem">
      <div class="ip-ecosystem-inner section-container">
        <h2 class="ip-section-title reveal">More on Claude</h2>
        <p class="ip-ecosystem-lede reveal">ExFu is one way in. Here are some useful places to go further.</p>

        <ul class="ip-ecosystem-links reveal">
          <li>
            <a href="https://docs.anthropic.com" target="_blank" rel="noopener noreferrer">Anthropic docs</a>
            <span class="ip-eco-desc">Official reference for Claude and the API.</span>
          </li>
          <li>
            <a href="https://claude.ai/learn" target="_blank" rel="noopener noreferrer">Claude help centre</a>
            <span class="ip-eco-desc">Getting started guides and FAQs from Anthropic.</span>
          </li>
          <li>
            <a href="https://claude101.com" target="_blank" rel="noopener noreferrer">Claude101</a>
            <span class="ip-eco-desc">Independent community guide to getting the most from Claude.</span>
          </li>
        </ul>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* ----------------------------------------
     Hero
  ---------------------------------------- */
  .ip-hero {
    background: var(--color-surface-dark);
    color: var(--color-text-dark);
    padding-top: calc(var(--space-3xl) + 60px); /* account for fixed nav */
    padding-bottom: var(--space-2xl);
  }

  .ip-hero-inner {
    max-width: var(--max-width);
  }

  .ip-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 400;
    color: var(--color-text-dark);
    margin-bottom: var(--space-md);
  }

  .ip-lede {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-muted);
  }

  /* ----------------------------------------
     Shared section scaffolding
  ---------------------------------------- */
  .ip-marketplace,
  .ip-plugins,
  .ip-primer,
  .ip-ecosystem {
    padding-block: var(--section-padding);
  }

  .ip-quickstart {
    padding-block: var(--section-padding);
    background: var(--color-surface-dark);
    color: var(--color-text-dark);
  }

  .ip-marketplace {
    background: var(--color-surface-light);
  }

  .ip-plugins {
    background: var(--color-surface-light);
    border-top: 1px solid rgba(138, 132, 124, 0.15);
  }

  .ip-primer {
    background: var(--color-surface-light);
    border-top: 1px solid rgba(138, 132, 124, 0.15);
  }

  .ip-ecosystem {
    background: var(--color-surface-light);
    border-top: 1px solid rgba(138, 132, 124, 0.15);
  }

  .ip-marketplace-inner,
  .ip-plugins-inner,
  .ip-quickstart-inner,
  .ip-primer-inner,
  .ip-ecosystem-inner {
    max-width: 50rem;
  }

  /* ----------------------------------------
     Marketplace step
  ---------------------------------------- */
  .ip-marketplace-lede {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
    max-width: none;
  }

  .ip-marketplace-note {
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-muted-dark);
    margin-top: var(--space-md);
    max-width: none;
  }

  .ip-marketplace-note a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .ip-marketplace-note a:hover {
    color: var(--color-accent-hover);
  }

  .ip-section-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    color: var(--color-primary);
    margin-bottom: var(--space-lg);
  }

  .ip-quickstart .ip-section-title {
    color: var(--color-text-dark);
  }

  /* ----------------------------------------
     Plugin card
  ---------------------------------------- */
  .ip-plugin-card {
    min-width: 0; /* let the command pre scroll instead of widening the grid track */
    background: white;
    border: 1px solid rgba(138, 132, 124, 0.2);
    border-radius: 8px;
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .ip-plugin-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .ip-plugin-name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-primary);
  }

  .ip-plugin-desc {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-text-light);
    flex-grow: 1;
    max-width: none;
  }

  /* ----------------------------------------
     Quick start steps
  ---------------------------------------- */
  .ip-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    list-style: none;
    margin-bottom: var(--space-lg);
  }

  .ip-steps li {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-text-dark);
  }

  .ip-step-num {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-accent);
    min-width: 1.5rem;
    line-height: 1;
  }

  .ip-steps a {
    color: var(--color-text-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .ip-steps a:hover {
    opacity: 1;
  }

  .ip-steps code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92em;
    padding: 0.1em 0.35em;
    background: rgba(237, 233, 228, 0.15);
    border-radius: 3px;
    color: var(--color-text-dark);
  }

  .ip-stuck {
    font-size: var(--text-body);
    color: rgba(237, 233, 228, 0.55);
    margin-top: var(--space-sm);
    max-width: none;
  }

  .ip-stuck a {
    color: rgba(237, 233, 228, 0.75);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .ip-stuck a:hover {
    color: var(--color-text-dark);
  }

  /* ----------------------------------------
     Primer section
  ---------------------------------------- */
  .ip-primer-inner p {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-text-light);
    max-width: none;
  }

  .ip-primer-inner code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92em;
    padding: 0.1em 0.35em;
    background: rgba(186, 67, 47, 0.08);
    border-radius: 3px;
    color: var(--color-primary);
  }

  /* ----------------------------------------
     Ecosystem links
  ---------------------------------------- */
  .ip-ecosystem-lede {
    font-size: var(--text-body-lg);
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
    max-width: none;
  }

  .ip-ecosystem-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    list-style: none;
  }

  .ip-ecosystem-links li {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .ip-ecosystem-links a {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .ip-ecosystem-links a:hover {
    color: var(--color-accent-hover);
  }

  .ip-eco-desc {
    font-size: var(--text-body);
    color: var(--color-muted-dark);
  }

  /* Copy block sits flush inside the card; the card already spaces its children */
  .ip-plugin-card .gs-copy-block {
    margin-block: 0;
  }

  /* Commands are one-liners: never word-wrap them, scroll sideways instead */
  .gs-copy-block {
    min-width: 0;
    max-width: 100%;
  }

  .gs-copy-block .gs-prompt {
    white-space: pre;
    word-break: normal;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  /* ----------------------------------------
     Responsive
  ---------------------------------------- */
  @media (max-width: 640px) {
    .ip-steps li {
      gap: var(--space-sm);
    }
  }
</style>


<script>
  // Copy-to-clipboard for the install commands
  document.querySelectorAll<HTMLButtonElement>('.gs-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-copy-target');
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;

      const text = target.textContent ?? '';
      const label = btn.querySelector<HTMLElement>('.gs-copy-btn-label');
      const originalLabel = label?.textContent ?? 'Copy';

      const flashSuccess = () => {
        if (label) label.textContent = 'Copied';
        btn.setAttribute('data-copied', 'true');
        window.setTimeout(() => {
          if (label) label.textContent = originalLabel;
          btn.removeAttribute('data-copied');
        }, 1800);
      };

      try {
        await navigator.clipboard.writeText(text);
        flashSuccess();
      } catch {
        // Fallback for older browsers / non-secure contexts
        const range = document.createRange();
        range.selectNode(target);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        try {
          document.execCommand('copy');
          flashSuccess();
        } catch {
          if (label) label.textContent = 'Copy failed';
          window.setTimeout(() => {
            if (label) label.textContent = originalLabel;
          }, 1800);
        }
        sel?.removeAllRanges();
      }
    });
  });
</script>
