---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/setup-pages.css';

// Public marketplace + plugin install command
const MARKETPLACE_ADD_CMD = '/plugin marketplace add ExFu/exfu-marketplace';
const SOLO_INSTALL_CMD = '/plugin install exfu-agent-library-solo@exfu';

const PLUGIN_DOCS_URL = 'https://docs.claude.com/en/docs/claude-code/plugins';
---

<BaseLayout
  title="Start the session — ExFu"
  description="Install the plugin, say the word, your AI takes over."
>
  <Nav />
  <main id="main">
    <section class="gs-hero">
      <div class="gs-hero-inner section-container">
        <h1 class="gs-title">Start the session</h1>
        <p class="gs-lede">Two commands and a sentence. Your AI takes it from there.</p>
      </div>
    </section>

    <section class="gs-steps">
      <div class="gs-steps-inner section-container">

        <article class="gs-step reveal">
          <div class="gs-step-number" aria-hidden="true">1</div>
          <div class="gs-step-body">
            <h2 class="gs-step-title">Check you're prepped</h2>
            <p>If you haven't worked through the <a href="/prepare">preparation steps</a>, start there first. Claude installed, <code>ExFu Library</code> folder created, settings flipped, connectors wired up.</p>
          </div>
        </article>

        <article class="gs-step reveal">
          <div class="gs-step-number" aria-hidden="true">2</div>
          <div class="gs-step-body">
            <h2 class="gs-step-title">Install the plugin</h2>
            <p>Open a new Cowork task in Claude Desktop and run these two commands. The first adds the public ExFu marketplace, the second installs your Agent Library.</p>

            <div class="gs-copy-block">
              <pre id="gs-marketplace-cmd" class="gs-prompt">{MARKETPLACE_ADD_CMD}</pre>
              <button
                class="gs-copy-btn"
                type="button"
                data-copy-target="gs-marketplace-cmd"
                aria-label="Copy command to clipboard"
              >
                <span class="gs-copy-btn-label">Copy</span>
              </button>
            </div>

            <div class="gs-copy-block">
              <pre id="gs-install-cmd" class="gs-prompt">{SOLO_INSTALL_CMD}</pre>
              <button
                class="gs-copy-btn"
                type="button"
                data-copy-target="gs-install-cmd"
                aria-label="Copy command to clipboard"
              >
                <span class="gs-copy-btn-label">Copy</span>
              </button>
            </div>

            <p>New to Claude plugins? <a href={PLUGIN_DOCS_URL} target="_blank" rel="noopener noreferrer">How plugins work</a>.</p>
          </div>
        </article>

        <article class="gs-step reveal">
          <div class="gs-step-number" aria-hidden="true">3</div>
          <div class="gs-step-body">
            <h2 class="gs-step-title">Kick off the setup</h2>
            <p>Restart Claude so the plugin loads. Then start a new task, point it at your <code>ExFu Library</code> folder, and paste this:</p>

            <div class="gs-copy-block">
              <pre id="gs-setup-prompt" class="gs-prompt">I've just installed ExFu and I'd like to get set up. My library lives in the `ExFu Library` folder I just created. Ask for permission to work in there, then take me through it.</pre>
              <button
                class="gs-copy-btn"
                type="button"
                data-copy-target="gs-setup-prompt"
                aria-label="Copy prompt to clipboard"
              >
                <span class="gs-copy-btn-label">Copy</span>
              </button>
            </div>

            <p>Hit enter. Your AI takes it from there.</p>
          </div>
        </article>

        <aside class="gs-note gs-tip reveal" role="note">
          <p><strong>One tip for later:</strong> you won't need to ask for that folder permission every time. In future sessions, use the <strong>"Work in Project"</strong> or <strong>"Work in Folder"</strong> dropdown just below the chat box and pick your <code>ExFu Library</code> folder so your AI knows where to work from.</p>
        </aside>

        <section class="gs-further reveal" aria-labelledby="gs-further-title">
          <h2 id="gs-further-title" class="gs-further-title">Want to go deeper?</h2>
          <p class="gs-further-para">Primers and guides ship inside the plugin. Once it's installed, ask for the ExFu guides and your AI will walk you through what the library is, how the librarians work, and how to extend it yourself.</p>
          <ul class="gs-further-links">
            <li>
              <a href="https://docs.anthropic.com" target="_blank" rel="noopener noreferrer">Anthropic docs</a>
              <span class="gs-further-desc">Official reference for Claude and the API.</span>
            </li>
            <li>
              <a href="https://claude.ai/learn" target="_blank" rel="noopener noreferrer">Claude help centre</a>
              <span class="gs-further-desc">Getting started guides and FAQs from Anthropic.</span>
            </li>
            <li>
              <a href="https://claude101.com" target="_blank" rel="noopener noreferrer">Claude101</a>
              <span class="gs-further-desc">Independent community guide to getting the most from Claude.</span>
            </li>
          </ul>
        </section>

        <p class="gs-stuck reveal">Stuck? Email <a href="mailto:al@exfu.ai">al@exfu.ai</a>.</p>

      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .gs-further {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(138, 132, 124, 0.2);
  }

  .gs-further-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .gs-further-para {
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
    max-width: none;
  }

  .gs-further-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
  }

  .gs-further-links li {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .gs-further-links a {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .gs-further-links a:hover {
    color: var(--color-accent-hover);
  }

  .gs-further-desc {
    font-size: var(--text-body);
    color: var(--color-muted-dark);
  }
</style>

<script>
  // Copy-to-clipboard
  document.querySelectorAll<HTMLButtonElement>('.gs-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-copy-target');
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;

      const text = target.textContent ?? '';
      const label = btn.querySelector<HTMLElement>('.gs-copy-btn-label');
      const originalLabel = label?.textContent ?? 'Copy';

      const flashSuccess = () => {
        if (label) label.textContent = 'Copied';
        btn.setAttribute('data-copied', 'true');
        window.setTimeout(() => {
          if (label) label.textContent = originalLabel;
          btn.removeAttribute('data-copied');
        }, 1800);
      };

      try {
        await navigator.clipboard.writeText(text);
        flashSuccess();
      } catch {
        // Fallback for older browsers / non-secure contexts
        const range = document.createRange();
        range.selectNode(target);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        try {
          document.execCommand('copy');
          flashSuccess();
        } catch {
          if (label) label.textContent = 'Copy failed';
          window.setTimeout(() => {
            if (label) label.textContent = originalLabel;
          }, 1800);
        }
        sel?.removeAllRanges();
      }
    });
  });
</script>
